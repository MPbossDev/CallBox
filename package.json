{
  "name": "callbox",
  "version": "1.0.0",
  "description": "CallBox - chamadas de voz e compartilhamento de tela para 2 ou 3 pessoas",
  "main": "electron/main.js",
  "author": "Você",
  "license": "MIT",
  "scripts": {
    "server": "node server/server.js",
    "app": "electron .",
    "dev": "concurrently -k -n SERVER,APP -c green,magenta \"npm run server\" \"npm run app\"",
    "build": "electron-builder"
  },
  "dependencies": {
    "express": "^4.19.2",
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.7.5"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "electron": "^32.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.callbox.app",
    "productName": "CallBox",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "client/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
